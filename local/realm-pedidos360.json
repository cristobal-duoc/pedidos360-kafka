{
  "realm": "pedidos360",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "solicitantes", "description": "Crea y edita sus solicitudes" },
      { "name": "aprobadores", "description": "Aprueba o rechaza solicitudes" }
    ]
  },
  "groups": [
    { "name": "solicitantes", "path": "/solicitantes", "realmRoles": ["solicitantes"] },
    { "name": "aprobadores", "path": "/aprobadores", "realmRoles": ["aprobadores"] }
  ],
  "users": [
    {
      "username": "solicitante@example.com",
      "email": "solicitante@example.com",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Solicitante",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Solicitante123!", "temporary": false }],
      "groups": ["/solicitantes"]
    },
    {
      "username": "aprobador@example.com",
      "email": "aprobador@example.com",
      "emailVerified": true,
      "firstName": "Jorge",
      "lastName": "Aprobador",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Aprobador123!", "temporary": false }],
      "groups": ["/aprobadores"]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "email", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        { "name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "username", "claim.name": "username", "jsonType.label": "String",
            "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" } }
      ]
    },
    {
      "name": "solicitudes/write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "solicitudes/approve",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "scopeMappings": [
    { "clientScope": "solicitudes/write", "roles": ["solicitantes"] },
    { "clientScope": "solicitudes/approve", "roles": ["aprobadores"] }
  ],
  "clients": [
    {
      "clientId": "pedidos360-front",
      "name": "Pedidos360 (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": ["profile", "basic", "email",
        "solicitudes/write", "solicitudes/approve"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "grupos",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "cognito:groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "client_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "client_id",
            "claim.value": "pedidos360-front",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
